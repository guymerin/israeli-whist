{
  "name": "israeli-whist",
  "version": "1.0.0",
  "description": "Browser-based Israeli Whist card game \u2014 vanilla JS, no build step.",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test": "npm run test:unit && npm run test:parity && npm run test:cards && npm run test:fan && npm run test:tray && npm run test:smoke && npm run test:strength",
    "test:unit": "node tests/mc-engine.test.mjs",
    "test:parity": "node tests/mc-parity.mjs",
    "test:cards": "node tests/card-selection.mjs",
    "test:fan": "node tests/hand-fan.mjs",
    "test:tray": "node tests/bid-tray.mjs",
    "test:strength": "node tests/mc-strength.mjs",
    "test:smoke": "node tests/smoke-test.mjs",
    "www": "node scripts/build-www.mjs",
    "ios:sync": "node scripts/build-www.mjs && npx cap sync ios",
    "ios:assets": "node scripts/make-native-assets.mjs && npx @capacitor/assets generate --ios",
    "ios:open": "npm run ios:sync && npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "playwright": "^1.48.0"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
